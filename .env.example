# GaussFlow environment configuration (copy to `.env` and fill in).
# No secrets are committed to the source tree — all credentials come from the environment.
#
# The values below are LOCAL-DEV defaults. They are intentionally insecure and MUST be
# overridden for any shared or hosted deployment. See SECURITY.md.

# --- SurrealDB (run persistence) ---
GAUSSFLOW_SURREAL_URL=ws://127.0.0.1:8000/rpc
GAUSSFLOW_DB_USER=root
# REQUIRED for non-local deployments — do not ship the default.
GAUSSFLOW_DB_PASS=root
GAUSSFLOW_DB_NS=gaussflow
GAUSSFLOW_DB_NAME=gaussflow

# --- Auth ---
# JWT signing secret. Leave empty in dev; Config::validate() rejects an empty secret, so this
# must be set to a strong random value to enable the authenticated API.
GAUSSFLOW_JWT_SECRET=

# --- LLM providers ---
# Required for live `llm_call` nodes and `synth` planning. The provider is chosen by model name
# (gpt* -> OpenAI, claude* -> Anthropic, mock* -> offline mock), or forced via GAUSSFLOW_LLM_PROVIDER.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider regardless of model name (mock | openai | anthropic | ollama).
GAUSSFLOW_LLM_PROVIDER=
# Local Ollama endpoint (used for `ollama/<model>` models).
OLLAMA_HOST=http://localhost:11434
